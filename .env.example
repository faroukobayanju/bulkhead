# testnet or mainnet (required)
NEAR_NETWORK=

# NEAR JSON-RPC URL (required unless MOCK_LLM)
NEAR_RPC=

# the vault contract account, e.g. bulkhead-vault.<team>.testnet (required unless MOCK_LLM)
VAULT_ACCOUNT=

# the agent's NEAR account (the verdict signer) (required unless MOCK_LLM)
AGENT_ACCOUNT=

# ed25519:... key of the agent; in the TEE it comes from the Shade Agent API, never from env (testnet only)
AGENT_PRIVATE_KEY=

# NEAR AI gateway, defaults to config/agent.json (https://cloud-api.near.ai/v1); mainnet refuses any other value (optional, testnet only)
NEARAI_BASE=

# NEAR AI Cloud key, with a spending limit set in its dashboard (required unless MOCK_LLM)
NEARAI_API_KEY=

# tier 1 model, defaults to config/agent.json and must equal the model the agent calls (optional)
TIER_MODEL_1=

# tier 2 model, same rule (optional)
TIER_MODEL_2=

# tier 3 model, same rule (optional)
TIER_MODEL_3=

# firewall judge model, defaults to config/agent.json (optional)
JUDGE_MODEL=

# Convex deployment URL (the web app uses it; the agent does not) (optional)
CONVEX_URL=

# Convex site URL that serves POST /agent/<op>; https unless local (required)
CONVEX_SITE_URL=

# 32+ bytes, equal to the Convex env var of the same name (required)
AGENT_SECRET=

# 32+ random bytes; hashes account and IP before they reach Convex (required)
PEPPER=

# 32+ random bytes; signs login sessions (required)
SESSION_SECRET=

# 32+ bytes shared with the web proxy (x-bulkhead-proxy-secret) (required)
PROXY_SECRET=

# mempool API, https://mempool.space/testnet4/api or https://mempool.space/api (required unless MOCK_LLM)
MEMPOOL_BASE=

# Base JSON-RPC URL (required unless MOCK_LLM, when tier 2 is on)
BASE_RPC=

# 1 (default) or 0 (optional)
TIER_ENABLED_1=

# 1 (default) or 0 (optional)
TIER_ENABLED_2=

# 1 (default) or 0 (optional)
TIER_ENABLED_3=

# measured image hash reported by /attestation and in every verdict; mock defaults to local, nothing else does (required unless MOCK_LLM)
CODEHASH=

# firewall version reported in every verdict; testnet and mock default to fw-v1 (required on mainnet)
FIREWALL_VERSION=

# public site, the base of docs_url in error bodies (required on mainnet)
SITE_URL=

# https URL that receives operator alerts; unset means no alerts (optional)
ALERT_WEBHOOK_URL=

# Convex deploy key used by the dataset export, never by the agent (export job only)
DATASET_DEPLOY_KEY=

# 1 replaces NEAR AI chat, the judge and attestation with canned fixtures (optional, testnet only)
MOCK_LLM=

# number in (0, 1] that shortens every rate-limit window (optional, testnet only)
RATE_LIMIT_SCALE=

# daily NEAR AI spend cap in USD, default 5 (optional)
NEARAI_DAILY_USD=

# tier agent call timeout, default 20000 (optional)
LLM_TIMEOUT_MS=

# judge call timeout, default 3500 (optional)
JUDGE_TIMEOUT_MS=

# listen port, default 8787 (optional)
PORT=
