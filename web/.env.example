# Server only. The agent's base URL and the shared proxy secret (the agent's PROXY_SECRET). Never NEXT_PUBLIC_.
AGENT_URL=
PROXY_SECRET=
# 1 serves web/fixtures for the agent, the vault and Convex: no agent, no chain, no wallet.
MOCK_AGENT=
# testnet or mainnet
NEXT_PUBLIC_NETWORK=testnet
# Public Convex deployment URL; browsers read public queries only.
NEXT_PUBLIC_CONVEX_URL=
# The vault contract account, and optional RPC overrides.
VAULT_ACCOUNT=
NEAR_RPC=
BASE_RPC=
# 0 shows a tier as not launched.
TIER_ENABLED_1=1
TIER_ENABLED_2=1
TIER_ENABLED_3=1
# Where the dataset download link points.
DATASET_URL=
